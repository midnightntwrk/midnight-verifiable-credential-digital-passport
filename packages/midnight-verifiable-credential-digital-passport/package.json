{
  "name": "@midnight-ntwrk/midnight-verifiable-credential-digital-passport",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./codecs": {
      "types": "./dist/codecs.d.ts",
      "require": "./dist/codecs.js",
      "import": "./dist/codecs.js",
      "default": "./dist/codecs.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./managed/digital-passport-credential/contract/index.js": {
      "types": "./dist/managed/digital-passport-credential/contract/index.d.ts",
      "import": "./dist/managed/digital-passport-credential/contract/index.js",
      "default": "./dist/managed/digital-passport-credential/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "codecs": [
        "dist/codecs.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "managed/digital-passport-credential/contract/index.js": [
        "dist/managed/digital-passport-credential/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "reference",
    "packageClass": "dist"
  }
}
