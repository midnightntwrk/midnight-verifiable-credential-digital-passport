engine-strict=true
enable-pre-post-scripts=true
# Reject package versions younger than 7 days (10080 minutes; supply-chain
# hardening, pairs with minimumReleaseAge in pnpm-workspace.yaml — pnpm 10
# reads this key, unlike the min-release-age spelling it silently ignores).
minimum-release-age=10080
audit=false
fund=false
